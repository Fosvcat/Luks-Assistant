import { Button, LineEdit, CheckBox, ComboBox, TabWidget, ScrollView, ListView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export struct LineItem {
    text: string,
    color: color,
    bold: bool,
}

export struct SlotCard {
    title: string,
    subtitle: string,
    color: color,
    empty: bool,
}

export struct PickRow {
    text: string,
    depth: int,
    enabled: bool,
}

// kind: 0 text, 1 secret, 2 toggle, 3 choice, 4 pcrs, 5 label
export struct FieldItem {
    kind: int,
    label: string,
    hint: string,
    text: string,
    checked: bool,
    options: [string],
    index: int,
    pcrs: [bool],
}

export struct IssueItem {
    severity: string,
    color: color,
    title: string,
    detail: string,
    fixable: bool,
}

export struct BackupRow {
    checked: bool,
    title: string,
    subtitle: string,
}

component Lines inherits ListView {
    in property <[LineItem]> lines;
    for l in lines: Text {
        text: l.text;
        color: l.color == #00000000 ? Palette.foreground : l.color;
        font-weight: l.bold ? 700 : 400;
        wrap: word-wrap;
    }
}

component Panel inherits Rectangle {
    in property <string> title;
    border-width: 1px;
    border-radius: 6px;
    border-color: Palette.border;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        if title != "": Text {
            text: title;
            font-weight: 700;
        }
        @children
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <color> accent: Palette.accent-background;
    background: Palette.background;
    border-radius: 8px;
    border-width: 2px;
    border-color: accent;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: title;
            font-size: 18px;
            font-weight: 700;
        }
        @children
    }
}

export component MainWindow inherits Window {
    title: "Luks Assistant";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 640px;
    default-font-size: 14px;

    // ---- global state
    in-out property <int> tab: 0;
    in property <string> header;
    in property <string> status;

    // ---- slots page
    in property <string> disk-label;
    in property <string> volume-count;
    in property <string> trim-label;
    in property <bool> trim-available;
    in property <[PickRow]> pick-rows;
    in property <[SlotCard]> slots;
    in property <string> slots-title;
    in-out property <int> selected: 0;
    in property <[LineItem]> detail;
    in property <[string]> actions;

    // ---- other pages
    in property <[LineItem]> sys-lines;
    in property <[LineItem]> disk-lines;
    in property <[LineItem]> pcr-lines;
    in property <[IssueItem]> issues;
    in property <[LineItem]> boot-lines;
    in property <string> backup-dir;
    in property <[BackupRow]> backups;
    in property <[string]> log-lines;

    // ---- modals: 0 none, 1 form, 2 confirm, 3 busy, 4 report, 5 recovery, 6 message
    in-out property <int> modal: 0;
    in property <string> modal-title;
    in property <color> modal-accent: Palette.accent-background;
    in property <[FieldItem]> form-fields;
    in property <string> form-error;
    in property <[LineItem]> form-notes;
    in property <[LineItem]> modal-lines;
    in property <string> confirm-word;
    in-out property <string> confirm-typed;
    in property <string> recovery-key;
    in property <string> message;
    in property <bool> message-closable: true;

    callback select-slot(int);
    callback action(int);
    callback open-verify();
    callback open-trim();
    callback pick-device(int);
    callback refresh();
    callback fix-issue(int);
    callback backup-toggle(int, bool);
    callback backup-all();
    callback backup-run();
    callback backup-restore(int);
    callback backup-set-dir(string);
    callback field-text(int, string);
    callback field-toggle(int, bool);
    callback field-choice(int, int);
    callback pcr-toggle(int, int);
    callback form-submit();
    callback modal-cancel();
    callback confirm-run();
    callback close-modal();

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.header;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: "刷新";
                clicked => { root.refresh(); }
            }
        }

        TabWidget {
            current-index <=> root.tab;

            Tab {
                title: "槽位";
                VerticalLayout {
                    padding: 6px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text { text: "磁盘"; vertical-alignment: center; }
                        disk-button := Button {
                            text: "▼ " + root.disk-label;
                            clicked => { picker.show(); }
                        }
                        Text { text: root.volume-count; vertical-alignment: center; }
                        Button {
                            text: "验证";
                            primary: true;
                            clicked => { root.open-verify(); }
                        }
                        Text { text: root.trim-label; vertical-alignment: center; }
                        if root.trim-available: Button {
                            text: "TRIM";
                            clicked => { root.open-trim(); }
                        }
                    }

                    Panel {
                        title: root.slots-title;
                        height: 4 * 66px + 40px;
                        grid := Rectangle {
                            for s[i] in root.slots: Rectangle {
                                x: Math.mod(i, 8) * (grid.width / 8);
                                y: Math.floor(i / 8) * 66px;
                                width: grid.width / 8 - 6px;
                                height: 60px;
                                border-radius: 6px;
                                border-width: i == root.selected ? 3px : 1px;
                                border-color: i == root.selected ? Palette.accent-background : s.color;
                                background: s.empty ? transparent : s.color.with-alpha(0.18);
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;
                                    Text {
                                        text: s.title;
                                        color: s.empty ? #888888 : Palette.foreground;
                                        font-weight: s.empty ? 400 : 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: s.subtitle;
                                        font-size: 12px;
                                        color: #888888;
                                        overflow: elide;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.select-slot(i); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for a[i] in root.actions: Button {
                            text: a;
                            clicked => { root.action(i); }
                        }
                    }

                    Panel {
                        title: "槽位 " + root.selected;
                        vertical-stretch: 1;
                        Lines { lines: root.detail; }
                    }
                }

                picker := PopupWindow {
                    x: disk-button.x;
                    y: disk-button.y + disk-button.height + 40px;
                    width: 760px;
                    height: min(28px * root.pick-rows.length + 16px, 480px);
                    Rectangle {
                        background: Palette.background;
                        border-width: 1px;
                        border-color: Palette.border;
                        border-radius: 6px;
                        ListView {
                            for r[i] in root.pick-rows: Rectangle {
                                height: 28px;
                                background: ta.has-hover && r.enabled ? Palette.selection-background : transparent;
                                Text {
                                    x: 10px + r.depth * 18px;
                                    text: r.text;
                                    vertical-alignment: center;
                                    color: r.enabled ? Palette.foreground : #888888;
                                }
                                ta := TouchArea {
                                    enabled: r.enabled;
                                    clicked => {
                                        root.pick-device(i);
                                        picker.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "系统信息";
                HorizontalLayout {
                    padding: 6px;
                    spacing: 8px;
                    Panel {
                        title: "系统";
                        horizontal-stretch: 1;
                        preferred-width: 100px;
                        Lines { lines: root.sys-lines; }
                    }
                    Panel {
                        title: "磁盘";
                        horizontal-stretch: 1;
                        preferred-width: 100px;
                        Lines { lines: root.disk-lines; }
                    }
                    Panel {
                        title: "PCR (sha256)";
                        horizontal-stretch: 1;
                        preferred-width: 100px;
                        Lines { lines: root.pcr-lines; }
                    }
                }
            }

            Tab {
                title: "体检";
                ListView {
                    for it[i] in root.issues: Rectangle {
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            Text {
                                text: it.severity;
                                color: it.color;
                                font-weight: 700;
                                width: 48px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: it.title; font-weight: 700; wrap: word-wrap; }
                                Text { text: it.detail; color: #888888; wrap: word-wrap; }
                            }
                            if it.fixable: Button {
                                text: "修复";
                                clicked => { root.fix-issue(i); }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "开机检查";
                VerticalLayout {
                    padding: 8px;
                    Text { text: "开机时 TPM2/FIDO2 自动解锁是否可用"; font-weight: 700; }
                    Lines { lines: root.boot-lines; }
                }
            }

            Tab {
                title: "备份";
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "备份位置"; vertical-alignment: center; }
                        dir-edit := LineEdit {
                            text: root.backup-dir;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "保存位置";
                            clicked => { root.backup-set-dir(dir-edit.text); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: "全选";
                            clicked => { root.backup-all(); }
                        }
                        Button {
                            text: "备份所选";
                            primary: true;
                            clicked => { root.backup-run(); }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for b[i] in root.backups: Rectangle {
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 10px;
                                CheckBox {
                                    checked: b.checked;
                                    toggled => { root.backup-toggle(i, self.checked); }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: b.title; font-weight: 700; overflow: elide; }
                                    Text { text: b.subtitle; color: #888888; overflow: elide; }
                                }
                                Button {
                                    text: "恢复";
                                    clicked => { root.backup-restore(i); }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "日志";
                ListView {
                    for l in root.log-lines: Text {
                        text: l;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Text {
            text: root.status;
            color: #888888;
            overflow: elide;
        }
    }

    // ---- modal layer
    if root.modal != 0: Rectangle {
        background: #00000070;
        TouchArea { }

        if root.modal == 1: Dialog {
            title: root.modal-title;
            width: min(760px, root.width - 40px);
            height: min(root.height - 40px, 700px);
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    for f[i] in root.form-fields: VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: f.label;
                                width: 120px;
                                vertical-alignment: center;
                                color: f.kind == 5 ? #888888 : Palette.foreground;
                                wrap: word-wrap;
                            }
                            if f.kind == 0: LineEdit {
                                text: f.text;
                                horizontal-stretch: 1;
                                edited(t) => { root.field-text(i, t); }
                            }
                            if f.kind == 1: LineEdit {
                                text: f.text;
                                input-type: InputType.password;
                                horizontal-stretch: 1;
                                edited(t) => { root.field-text(i, t); }
                            }
                            if f.kind == 2: CheckBox {
                                checked: f.checked;
                                toggled => { root.field-toggle(i, self.checked); }
                            }
                            if f.kind == 3: ComboBox {
                                model: f.options;
                                current-index: f.index;
                                horizontal-stretch: 1;
                                selected => { root.field-choice(i, self.current-index); }
                            }
                            if f.kind == 4: HorizontalLayout {
                                spacing: 2px;
                                for on[j] in f.pcrs: Rectangle {
                                    width: 21px;
                                    height: 26px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    background: on ? #8e44ad : transparent;
                                    Text {
                                        text: j;
                                        font-size: 11px;
                                        color: on ? white : Palette.foreground;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.pcr-toggle(i, j); }
                                    }
                                }
                            }
                        }
                        if f.hint != "": Text {
                            text: "                              " + f.hint;
                            font-size: 12px;
                            color: #888888;
                        }
                    }
                    for n in root.form-notes: Text {
                        text: n.text;
                        color: n.color == #00000000 ? Palette.foreground : n.color;
                        font-weight: n.bold ? 700 : 400;
                        wrap: word-wrap;
                    }
                }
            }
            if root.form-error != "": Text {
                text: "✗ " + root.form-error;
                color: #e74c3c;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "取消";
                    clicked => { root.modal-cancel(); }
                }
                Button {
                    text: "下一步";
                    primary: true;
                    clicked => { root.form-submit(); }
                }
            }
        }

        if root.modal == 2: Dialog {
            title: root.modal-title;
            accent: root.modal-accent;
            width: min(980px, root.width - 40px);
            height: root.height - 60px;
            Lines {
                vertical-stretch: 1;
                lines: root.modal-lines;
            }
            if root.confirm-word != "": HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "输入 " + root.confirm-word + " 以确认";
                    color: #e74c3c;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                LineEdit {
                    text <=> root.confirm-typed;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "取消";
                    clicked => { root.modal-cancel(); }
                }
                Button {
                    text: "执行";
                    primary: true;
                    enabled: root.confirm-word == "" || root.confirm-typed == root.confirm-word;
                    clicked => { root.confirm-run(); }
                }
            }
        }

        if root.modal == 3: Dialog {
            title: root.modal-title;
            width: min(760px, root.width - 40px);
            height: min(420px, root.height - 40px);
            Lines {
                vertical-stretch: 1;
                lines: root.modal-lines;
            }
        }

        if root.modal == 4: Dialog {
            title: root.modal-title;
            accent: root.modal-accent;
            width: min(980px, root.width - 40px);
            height: root.height - 60px;
            Lines {
                vertical-stretch: 1;
                lines: root.modal-lines;
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "关闭";
                    primary: true;
                    clicked => { root.close-modal(); }
                }
            }
        }

        if root.modal == 5: Dialog {
            title: "恢复密钥";
            accent: #f1c40f;
            width: min(820px, root.width - 40px);
            height: self.preferred-height;
            TextInput {
                text: root.recovery-key;
                read-only: true;
                font-size: 22px;
                font-weight: 700;
                single-line: true;
                horizontal-alignment: center;
            }
            Text {
                text: "只显示这一次，请离线保存";
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "我已保存";
                    primary: true;
                    clicked => { root.close-modal(); }
                }
            }
        }

        if root.modal == 6: Dialog {
            title: root.modal-title;
            width: min(640px, root.width - 40px);
            height: self.preferred-height;
            Text {
                text: root.message;
                wrap: word-wrap;
            }
            if root.message-closable: HorizontalLayout {
                alignment: end;
                Button {
                    text: "确定";
                    primary: true;
                    clicked => { root.close-modal(); }
                }
            }
        }
    }
}
